{
	"name": "@plugdash/shortlink",
	"version": "0.2.4",
	"description": "Short URLs for EmDash posts - one native EmDash redirect per published entry",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"pretty-links",
		"shortlink"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/plugdash/plugdash.git",
		"directory": "packages/shortlink"
	},
	"files": [
		"dist",
		"src/*.astro",
		"src/code.ts"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./CopyLink.astro": "./src/CopyLink.astro"
	},
	"scripts": {
		"build": "tsdown src/index.ts --dts.eager",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --ignore-pattern '*.astro' ."
	},
	"devDependencies": {
		"emdash": "^1.0.1",
		"vitest": "^2.0.0"
	},
	"peerDependencies": {
		"emdash": ">=1.0.0"
	}
}
