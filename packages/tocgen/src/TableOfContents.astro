---
/**
 * @plugdash/tocgen - TableOfContents.astro
 *
 * Builds the table of contents from the post body at render time. No plugin
 * registration, hooks or stored data. Renders nothing when there are fewer
 * than minHeadings headings. Pair it with <HeadingAnchors /> so every link
 * has a target.
 *
 * Props:
 *   post        - EmDash content item (required)
 *   maxDepth    - deepest heading level, 2 | 3 | 4, default 3
 *   minHeadings - headings needed before a TOC shows, default 3
 *   field       - Portable Text field name, default content, then body
 *   sticky      - stick to the top while scrolling, default false
 *   class       - additional CSS class
 */
import TocList from "./TocList.astro";
import { getBodyBlocks, getToc, type TocEntry } from "@plugdash/tocgen/utils";

interface Props {
	post: Record<string, unknown>;
	maxDepth?: 2 | 3 | 4;
	minHeadings?: number;
	field?: string;
	sticky?: boolean;
	class?: string;
}

const {
	post,
	maxDepth = 3,
	minHeadings = 3,
	field,
	sticky = false,
	class: className = "",
} = Astro.props;

// Old tocgen versions stored entries in metadata. Used only when no body is found.
const legacy = (post?.data as Record<string, any> | undefined)?.metadata?.tocgen?.entries;
const entries: TocEntry[] = getBodyBlocks(post, field)
	? getToc(post, { maxDepth, minHeadings, field })
	: Array.isArray(legacy)
		? legacy
		: [];
---

{
	entries.length > 0 && (
		<nav
			class={`plugdash-toc ${sticky ? "plugdash-toc--sticky" : ""} ${className}`.trim()}
			aria-label="Table of contents"
		>
			<TocList items={entries} depth={2} maxDepth={maxDepth} />
		</nav>
	)
}

<style>
	.plugdash-toc {
		font-family: var(--plugdash-font-ui, "Lexend", system-ui, sans-serif);
		font-size: var(--plugdash-toc-size, 0.875rem);
		line-height: var(--plugdash-toc-line-height, 1.6);
	}

	.plugdash-toc--sticky {
		position: sticky;
		top: var(--plugdash-toc-top, 2rem);
		max-height: var(--plugdash-toc-max-height, calc(100vh - 4rem));
		overflow-y: auto;
	}

	.plugdash-toc :global(ul) {
		list-style: none;
		padding-left: var(--plugdash-toc-indent, 1rem);
		margin: 0;
	}

	.plugdash-toc > :global(ul) {
		padding-left: 0;
	}

	.plugdash-toc :global(li) {
		margin: 0;
	}

	.plugdash-toc :global(a) {
		color: var(--plugdash-toc-color, inherit);
		text-decoration: none;
		transition: color var(--plugdash-transition, 150ms ease);
	}

	.plugdash-toc :global(a:hover) {
		color: var(--plugdash-toc-hover, var(--plugdash-accent, #6366f1));
	}
</style>
