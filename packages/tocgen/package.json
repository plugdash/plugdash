{
	"name": "@plugdash/tocgen",
	"version": "0.2.4",
	"description": "Table of contents for EmDash posts, computed at render time with no hooks or stored data",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"table-of-contents",
		"tocgen"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/plugdash/plugdash.git",
		"directory": "packages/tocgen"
	},
	"files": [
		"dist",
		"src/*.astro"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./utils": {
			"import": "./dist/toc.mjs",
			"types": "./dist/toc.d.mts"
		},
		"./TableOfContents.astro": "./src/TableOfContents.astro",
		"./HeadingAnchors.astro": "./src/HeadingAnchors.astro"
	},
	"scripts": {
		"build": "tsdown src/index.ts src/toc.ts --dts.eager",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@plugdash/testing": "workspace:*",
		"@plugdash/types": "workspace:*",
		"@portabletext/types": "^2.0.0",
		"vitest": "^2.0.0"
	},
	"peerDependencies": {
		"emdash": ">=0.13.0"
	}
}
