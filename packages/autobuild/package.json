{
	"name": "@plugdash/autobuild",
	"version": "0.2.2",
	"description": "Fires a Cloudflare Pages, Netlify, or Vercel build hook when content is published or unpublished, for static sites that read EmDash at build time",
	"keywords": [
		"autobuild",
		"ci-cd",
		"cloudflare-pages",
		"deploy-hook",
		"emdash",
		"emdash-plugin",
		"netlify",
		"vercel"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/plugdash/plugdash.git",
		"directory": "packages/autobuild"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		}
	},
	"scripts": {
		"build": "tsdown src/index.ts --dts.eager",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@plugdash/testing": "workspace:*",
		"@plugdash/types": "workspace:*",
		"emdash": "^1.0.1",
		"vitest": "^2.0.0"
	},
	"peerDependencies": {
		"emdash": ">=1.0.0"
	}
}
