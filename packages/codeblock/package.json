{
	"name": "@plugdash/codeblock",
	"version": "0.3.0",
	"description": "Shiki syntax highlighting for EmDash code blocks - rendered server-side, with a copy button",
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./astro": "./src/astro/index.ts",
		"./CodeBlock.astro": "./src/CodeBlock.astro"
	},
	"files": [
		"dist",
		"src/astro",
		"src/*.astro",
		"src/highlight.ts"
	],
	"scripts": {
		"build": "tsdown src/index.ts --dts.eager",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"emdash",
		"emdash-plugin",
		"codeblock",
		"shiki",
		"syntax-highlighting"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/plugdash/plugdash.git",
		"directory": "packages/codeblock"
	},
	"peerDependencies": {
		"emdash": ">=0.13.0"
	},
	"dependencies": {
		"shiki": "^4.0.0"
	},
	"devDependencies": {
		"@plugdash/types": "workspace:*",
		"@plugdash/testing": "workspace:*",
		"vitest": "^2.0.0"
	}
}
