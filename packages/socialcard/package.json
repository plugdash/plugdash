{
	"name": "@plugdash/socialcard",
	"version": "0.2.0",
	"description": "Share images for EmDash posts - renders a PNG card on publish and sets it as the post's SEO image",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"og-image",
		"open-graph",
		"png",
		"social-sharing",
		"socialcard"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/plugdash/plugdash.git",
		"directory": "packages/socialcard"
	},
	"files": [
		"dist",
		"OFL-Lexend.txt"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./card": {
			"import": "./dist/card.mjs",
			"types": "./dist/card.d.mts"
		}
	},
	"scripts": {
		"build": "tsdown src/index.ts src/card.ts --dts.eager",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint ."
	},
	"dependencies": {
		"@resvg/resvg-wasm": "^2.6.2"
	},
	"devDependencies": {
		"@plugdash/testing": "workspace:*",
		"@plugdash/types": "workspace:*",
		"@types/node": "^22.20.5",
		"emdash": "^1.0.1",
		"vitest": "^2.0.0"
	},
	"peerDependencies": {
		"emdash": ">=1.0.0"
	}
}
