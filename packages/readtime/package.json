{
	"name": "@plugdash/readtime",
	"version": "0.3.0",
	"description": "Reading time for EmDash posts, computed at render time with no hooks or stored data",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"reading-time",
		"readtime",
		"word-count"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/plugdash/plugdash.git",
		"directory": "packages/readtime"
	},
	"files": [
		"dist",
		"src/*.astro"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./utils": {
			"import": "./dist/reading-time.mjs",
			"types": "./dist/reading-time.d.mts"
		},
		"./ReadingTime.astro": "./src/ReadingTime.astro"
	},
	"scripts": {
		"build": "tsdown src/index.ts src/reading-time.ts --dts.eager",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@plugdash/types": "workspace:*",
		"vitest": "^2.0.0"
	},
	"peerDependencies": {
		"emdash": ">=0.13.0"
	}
}
