{
	"name": "@plugdash/enrichkit",
	"version": "0.1.2",
	"description": "Adds an AI summary, topics, tags and a tweet draft to EmDash posts with one LLM call per changed publish",
	"keywords": [
		"ai",
		"auto-tagging",
		"emdash",
		"emdash-plugin",
		"enrichkit",
		"llm",
		"metadata",
		"summary"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/plugdash/plugdash.git",
		"directory": "packages/enrichkit"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown src/index.ts --dts.eager",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint ."
	},
	"devDependencies": {
		"@plugdash/testing": "workspace:*",
		"@plugdash/types": "workspace:*",
		"emdash": "^1.0.1",
		"vitest": "^2.0.0"
	},
	"peerDependencies": {
		"emdash": ">=1.0.0"
	}
}
