{
	"name": "@plugdash/enrichkit",
	"version": "0.1.0",
	"description": "Enriches published EmDash content with an AI summary, key topics, auto-tags, reading level, and a tweet draft",
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": {
			"import": "./dist/sandbox-entry.mjs"
		},
		"./enrich-logic": {
			"import": "./dist/enrich-logic.mjs",
			"types": "./dist/enrich-logic.d.mts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts --dts.eager && tsdown src/sandbox-entry.ts --dts.eager --no-clean && tsdown src/enrich-logic.ts --dts.eager --no-clean",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint ."
	},
	"keywords": [
		"emdash",
		"emdash-plugin",
		"enrichkit",
		"ai",
		"llm",
		"metadata",
		"summary",
		"auto-tagging"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/plugdash/plugdash.git",
		"directory": "packages/enrichkit"
	},
	"peerDependencies": {
		"emdash": ">=0.13.0"
	},
	"devDependencies": {
		"@plugdash/types": "workspace:*",
		"@plugdash/testing": "workspace:*",
		"vitest": "^2.0.0"
	}
}
